PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase Auth & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatai
JWT_SECRET=change-this-to-a-64-char-random-string
JWT_EXPIRES_IN=7d

# AI — OpenAI for embeddings, OpenRouter for free chat model
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
DEFAULT_FREE_MODEL=qwen/qwen3-235b-a22b:free
DEFAULT_PAID_MODEL=gpt-4o

# Resend (Transactional Email)
RESEND_API_KEY=re_xxxx_xxxx
EMAIL_FROM=ChatAI <noreply@yourdomain.com>

# SMTP (Legacy Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=ChatAI <you@gmail.com>

# Stripe (USD)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_HOBBY=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...

# Razorpay (INR)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
WIDGET_BASE_URL=http://localhost:4000

# Google Integration (service account JSON as single line)
GOOGLE_SERVICE_ACCOUNT_JSON={}
LEADS_SHEET_ID=your-sheet-id-here

# Twilio (WhatsApp outreach)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886
