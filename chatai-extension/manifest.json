{
  "manifest_version": 3,
  "name": "Chatbolt Browser Connector",
  "version": "1.0",
  "description": "Connects your local browser session securely to Chatbolt AI.",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
